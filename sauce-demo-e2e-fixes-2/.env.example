# Copy to .env and adjust. Every value is optional - defaults are in config/settings.py
BASE_URL=https://sauce-demo.myshopify.com
DEFAULT_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
EXPECT_TIMEOUT_MS=8000
SLOW_MO_MS=0
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800
LOCALE=en-GB
TIMEZONE_ID=Asia/Manila

# Opt-in: creates REAL customer accounts on the demo store. Keep false unless you really need it.
ALLOW_REGISTRATION=false

# Optional: enables the positive login test (an existing customer you own on the store)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Pause after every test (seconds) so the shared demo store does not rate-limit us
PACING_SECONDS=1.0
